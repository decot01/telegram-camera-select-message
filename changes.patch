+package org.telegram.ui.Components.cameraselect;
+
+/** Pixel placement separated from Android so density and bar movement can be regression tested. */
+public final class CameraSelectPlacement {
+    public static final int BAR_GAP_PX = 80;
+    public static final float FRONT_BOTTOM_DP = 246.5f;
+    public static final float TARGET_MIDPOINT_DP = (68.25f + 225.5f) / 2f;
+
+    private CameraSelectPlacement() {}
+
+    public static int top(float density, int barTopPx) {
+        return barTopPx - BAR_GAP_PX - (int) Math.ceil(FRONT_BOTTOM_DP * density);
+    }
+
+    /** Chat's custom parent may add its action bar/insets after applying layout margins. */
+    public static int translation(int desired, int laidOut) {
+        return desired - laidOut;
+    }
+
+    public static float backPull(float density, float touchDownY, int railTopScreenPx) {
+        float midpoint = railTopScreenPx + TARGET_MIDPOINT_DP * density;
+        return Math.max(CameraSelectGesture.FRONT_PULL + 16f, (touchDownY - midpoint) / density);
+    }
+}
