+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/cameraselect/CameraSelectGesture.java
@@ -0,0 +1,60 @@
+package org.telegram.ui.Components.cameraselect;
+
+/** UI-independent state machine. Coordinates are dp; time is monotonic milliseconds. */
+public final class CameraSelectGesture {
+    public static final int NONE = 0, FRONT = 1, BACK = 2;
+    public static final long HOLD_MS = 150, SETTLE_MS = 180;
+    public static final float FRONT_PULL = 95f, BACK_PULL = 237f, CANCEL_PULL = 72f;
+    private boolean active, recording, cancelled;
+    private int candidate, selected;
+    private float originX, originY, stableX, stableY;
+    private long downAt, stableAt;
+
+    public void begin(float x, float y, long now) {
+        active = true;
+        recording = cancelled = false;
+        candidate = selected = NONE;
+        originX = stableX = x;
+        originY = stableY = y;
+        downAt = stableAt = now;
+    }
+
+    public void move(float x, float y, long now) {
+        if (!active) return;
+        if (x - originX <= -CANCEL_PULL) {
+            cancelled = true;
+            candidate = NONE;
+            return;
+        }
+        if (recording || cancelled) return;
+        float pull = originY - y;
+        int next = Math.abs(x - originX) > 48 ? NONE : pull >= BACK_PULL ? BACK : pull >= FRONT_PULL ? FRONT : NONE;
+        // Require a pause on a target, rather than starting the front camera in transit.
+        if (next != candidate || Math.hypot(x - stableX, y - stableY) > 6) {
+            stableAt = now;
+            stableX = x;
+            stableY = y;
+        }
+        candidate = next;
+    }
+
+    /** Returns the camera once, when the target has settled. */
+    public int tick(long now) {
+        if (!active || recording || cancelled || candidate == NONE || now - downAt < HOLD_MS || now - stableAt < SETTLE_MS) return NONE;
+        recording = true;
+        selected = candidate;
+        return selected;
+    }
+
+    public boolean isRailVisible(long now) { return active && !cancelled && now - downAt >= HOLD_MS; }
+    public boolean isActive() { return active; }
+    public boolean isRecording() { return recording; }
+    public boolean isCancelled() { return cancelled; }
+    public int getCandidate() { return recording ? selected : candidate; }
+    public int finish() {
+        int result = active && recording && !cancelled ? selected : NONE;
+        active = false;
+        return result;
+    }
+    public void cancel() { cancelled = true; active = false; }
+}
