+    private int candidate, foregroundColor, accentColor, backgroundColor;
+    private float reveal, mainSelected, frontSelected;
+    private boolean shown;
+    private int desiredLeft, desiredTop;
+    private boolean hasPlacement;
+
+    private static final FloatPropertyCompat<CameraSelectRailView> REVEAL =
+            new FloatPropertyCompat<CameraSelectRailView>("cameraSelectReveal") {
+                @Override public float getValue(CameraSelectRailView view) { return view.reveal; }
+                @Override public void setValue(CameraSelectRailView view, float value) {
+                    view.reveal = value;
+                    view.invalidate();
+                }
+            };
+    private static final FloatPropertyCompat<CameraSelectRailView> MAIN =
+            new FloatPropertyCompat<CameraSelectRailView>("cameraSelectMain") {
+                @Override public float getValue(CameraSelectRailView view) { return view.mainSelected; }
+                @Override public void setValue(CameraSelectRailView view, float value) {
+                    view.mainSelected = value;
+                    view.updateIconColors();
+                    view.invalidate();
+                }
+            };
+    private static final FloatPropertyCompat<CameraSelectRailView> FRONT =
+            new FloatPropertyCompat<CameraSelectRailView>("cameraSelectFront") {
+                @Override public float getValue(CameraSelectRailView view) { return view.frontSelected; }
+                @Override public void setValue(CameraSelectRailView view, float value) {
+                    view.frontSelected = value;
+                    view.updateIconColors();
+                    view.invalidate();
+                }
+            };
+
+    public CameraSelectRailView(Context context, Theme.ResourcesProvider resourcesProvider,
+                                BlurredBackgroundDrawableViewFactory factory) {
+        super(context);
+        this.resourcesProvider = resourcesProvider;
+        fallbackShadow = context.getDrawable(R.drawable.lock_round_shadow).mutate();
+        glassColors = new BlurredBackgroundColorProviderThemed(resourcesProvider,
+                Theme.key_chat_messagePanelVoiceLockBackground);
+        if (factory != null) {
+            mainGlass = factory.create(this, glassColors);
+            frontGlass = factory.create(this, glassColors);
+            configureGlass(mainGlass, 40, 32, 82, 104.5f);
+            configureGlass(frontGlass, 40, 204.5f, 82, FRONT_BOTTOM_DP);
+        } else {
+            mainGlass = frontGlass = null;
+        }
+        camera = context.getDrawable(R.drawable.camera_select_main).mutate();
+        chevron = context.getDrawable(R.drawable.camera_select_chevron).mutate();
+        front = context.getDrawable(R.drawable.camera_select_front).mutate();
+        revealSpring = spring(REVEAL, 1000f);
+        mainSpring = spring(MAIN, 1500f);
+        frontSpring = spring(FRONT, 1500f);
+        revealSpring.addEndListener((animation, canceled, value, velocity) -> {
+            if (!canceled && !shown) setVisibility(INVISIBLE);
+        });
+        setVisibility(INVISIBLE);
+        setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);
+        setClickable(false);
+        updateColors();
+    }
+
+    private SpringAnimation spring(FloatPropertyCompat<CameraSelectRailView> property, float stiffness) {
+        SpringAnimation animation = new SpringAnimation(this, property);
+        animation.setSpring(new SpringForce(0f).setStiffness(stiffness)
+                .setDampingRatio(SpringForce.DAMPING_RATIO_NO_BOUNCY));
+        animation.setMinimumVisibleChange(.002f);
+        return animation;
+    }
+
+    public void prepareForGesture() {
+        mainSpring.cancel();
+        frontSpring.cancel();
+        candidate = CameraSelectGesture.NONE;
+        mainSelected = frontSelected = 0f;
+        updateIconColors();
+    }
+
+    public void setPlacement(int left, int top) {
+        desiredLeft = left;
+        desiredTop = top;
+        hasPlacement = true;
+        applyPlacement();
+    }
+
+    private void applyPlacement() {
+        if (!hasPlacement) return;
+        setTranslationX(CameraSelectPlacement.translation(desiredLeft, getLeft()));
+        setTranslationY(CameraSelectPlacement.translation(desiredTop, getTop()));
+    }
+
+    @Override protected void onLayout(boolean changed, int left, int top, int right, int bottom) {
+        super.onLayout(changed, left, top, right, bottom);
+        applyPlacement();
+    }
+
+    public void show() {
+        shown = true;
+        updateColors();
+        if (getVisibility() != VISIBLE) {
+            reveal = 0f;
+            setVisibility(VISIBLE);
+        }
+        revealSpring.animateToFinalPosition(1f);
+    }
+
+    public void hide() {
+        shown = false;
+        revealSpring.animateToFinalPosition(0f);
+    }
+
+    private void configureGlass(BlurredBackgroundDrawable glass, float left, float top, float right, float bottom) {
+        glass.setRadius(AndroidUtilities.dp(21));
+        int padding = AndroidUtilities.dp(3);
+        glass.setPadding(padding);
+        glass.setBounds(AndroidUtilities.dp(left) - padding, AndroidUtilities.dp(top) - padding,
+                AndroidUtilities.dp(right) + padding, AndroidUtilities.dp(bottom) + padding);
+        glass.setReservedBounds(AndroidUtilities.dp(left - 5), AndroidUtilities.dp(top - 5),
+                AndroidUtilities.dp(right + 5), AndroidUtilities.dp(bottom + 5));
+        glass.setCallback(this);
+    }
+
+    @Override protected boolean verifyDrawable(Drawable drawable) {
+        return drawable == mainGlass || drawable == frontGlass || super.verifyDrawable(drawable);
+    }
+
+    public void updateColors() {
+        backgroundColor = Theme.getColor(Theme.key_chat_messagePanelVoiceLockBackground, resourcesProvider);
+        foregroundColor = Theme.getColor(mainGlass != null
+                ? Theme.key_glass_defaultIcon : Theme.key_chat_messagePanelVoiceLock, resourcesProvider);
+        accentColor = Theme.getColor(Theme.key_chat_recordVoiceCancel, resourcesProvider);
+        fallbackPaint.setColor(backgroundColor);
+        fallbackShadow.setColorFilter(new PorterDuffColorFilter(
+                Theme.getColor(Theme.key_chat_messagePanelVoiceLockShadow, resourcesProvider), PorterDuff.Mode.MULTIPLY));
+        glassColors.updateColors();
+        if (mainGlass != null) mainGlass.updateColors();
+        if (frontGlass != null) frontGlass.updateColors();
+        updateIconColors();
+        invalidate();
+    }
+
+    public void dispose() {
+        revealSpring.cancel();
+        mainSpring.cancel();
+        frontSpring.cancel();
+        if (mainGlass != null) mainGlass.setCallback(null);
+        if (frontGlass != null) frontGlass.setCallback(null);
+    }
+
+    private void updateIconColors() {
+        int mainColor = ColorUtils.blendARGB(foregroundColor, accentColor, clamp(mainSelected));
+        camera.setTint(mainColor);
+        chevron.setTint(mainColor);
+        front.setTint(ColorUtils.blendARGB(foregroundColor, accentColor, clamp(frontSelected)));
+    }
+
+    public void setState(int candidate, float pull) {
+        if (this.candidate == candidate) return;
+        this.candidate = candidate;
+        mainSpring.animateToFinalPosition(candidate == CameraSelectGesture.BACK ? 1f : 0f);
+        frontSpring.animateToFinalPosition(candidate == CameraSelectGesture.FRONT ? 1f : 0f);
+    }
+
+    @Override protected void onDetachedFromWindow() {
+        revealSpring.cancel();
+        mainSpring.cancel();
+        frontSpring.cancel();
+        super.onDetachedFromWindow();
+    }
+
+    @Override protected void onDraw(Canvas canvas) {
+        float appearance = clamp(reveal);
+        float near = clamp(appearance * 1.12f);
+        float far = clamp((appearance - .10f) / .90f);
+        drawTarget(canvas, mainGlass, 32, 104.5f, 68.25f, far, mainSelected, true);
+        drawTarget(canvas, frontGlass, 204.5f, FRONT_BOTTOM_DP, FRONT_CENTER_Y_DP, near, frontSelected, false);
+    }
+
+    private void drawTarget(Canvas canvas, BlurredBackgroundDrawable glass, float top, float bottom,
+                            float cy, float appearance, float selected, boolean main) {
+        if (appearance <= 0f) return;
+        int alpha = Math.round(255 * appearance);
+        float scale = .90f + .10f * appearance + .045f * clamp(selected);
+        canvas.save();
+        canvas.translate(0, AndroidUtilities.dpf2((1f - appearance) * (main ? 12f : 8f)
+                - (main ? 1.5f * clamp(selected) : 0f)));
+        // Keep the near circle's resting bottom anchored to the 80px gap when selected.
+        canvas.scale(scale, scale, AndroidUtilities.dpf2(CENTER_X_DP),
+                main ? AndroidUtilities.dpf2(cy) : AndroidUtilities.dp(FRONT_BOTTOM_DP));
+        if (glass != null) {
+            glass.setAlpha(alpha);
+            glass.draw(canvas);
+        } else {
+            fallbackShadow.setAlpha(alpha);
+            fallbackShadow.setBounds(AndroidUtilities.dp(37), AndroidUtilities.dp(top - 3),
+                    AndroidUtilities.dp(85), AndroidUtilities.dp(bottom + 3));
+            fallbackShadow.draw(canvas);
+            fallbackPaint.setAlpha(Math.round(android.graphics.Color.alpha(backgroundColor) * appearance));
+            bounds.set(AndroidUtilities.dp(40), AndroidUtilities.dp(top),
+                    AndroidUtilities.dp(82), AndroidUtilities.dp(bottom));
+            canvas.drawRoundRect(bounds, AndroidUtilities.dp(21), AndroidUtilities.dp(21), fallbackPaint);
+        }
+        if (main) {
+            icon(canvas, camera, 50, 50.25f, 22, 16, alpha);
+            icon(canvas, chevron, 52, 78.25f, 18, 8, alpha);
+        } else {
+            icon(canvas, front, 51, 214.5f, 20, 22, alpha);
+        }
+        canvas.restore();
+    }
+
+    private static float clamp(float value) { return Math.max(0f, Math.min(1f, value)); }
+
+    private void icon(Canvas canvas, Drawable drawable, float x, float y, int w, int h, int alpha) {
+        canvas.save();
+        canvas.translate(AndroidUtilities.dpf2(x), AndroidUtilities.dpf2(y));
+        float density = getResources().getDisplayMetrics().density;
+        canvas.scale(density, density);
+        drawable.setAlpha(alpha);
+        drawable.setBounds(0, 0, w, h);
+        drawable.draw(canvas);
+        canvas.restore();
+    }
+}
