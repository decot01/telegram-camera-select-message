@@ -0,0 +1,104 @@
+package org.telegram.ui.Components.cameraselect;
+
+import android.content.Context;
+import android.content.res.ColorStateList;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.graphics.drawable.Drawable;
+import android.view.View;
+
+/** Figma 5:449: 42 x 72.5 pill, 42 circle at y=172.5. No bitmap UI. */
+public final class CameraSelectRailView extends View {
+    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF rect = new RectF();
+    private final Drawable main, chevron, front;
+    private final float density;
+    private int candidate;
+    private boolean dark;
+    private Drawable mainGlass, frontGlass;
+
+    public CameraSelectRailView(Context context, int mainId, int chevronId, int frontId) {
+        super(context);
+        density = getResources().getDisplayMetrics().density;
+        main = context.getDrawable(mainId).mutate();
+        chevron = context.getDrawable(chevronId).mutate();
+        front = context.getDrawable(frontId).mutate();
+        setLayerType(View.LAYER_TYPE_SOFTWARE, null);
+        setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);
+        setClickable(false);
+    }
+
+    public void setState(int candidate, boolean dark) {
+        if (this.candidate == candidate && this.dark == dark) return;
+        this.candidate = candidate;
+        this.dark = dark;
+        invalidate();
+    }
+
+    /** The host supplies its own live glass so blur, tint and low-power fallbacks match the chat. */
+    public void setGlassBackgrounds(Drawable mainGlass, Drawable frontGlass) {
+        this.mainGlass = mainGlass;
+        this.frontGlass = frontGlass;
+        mainGlass.setCallback(this);
+        frontGlass.setCallback(this);
+        setLayerType(View.LAYER_TYPE_NONE, null);
+        invalidate();
+    }
+
+    @Override protected boolean verifyDrawable(Drawable drawable) {
+        return drawable == mainGlass || drawable == frontGlass || super.verifyDrawable(drawable);
+    }
+
+    @Override protected void onDraw(Canvas canvas) {
+        drawGlass(canvas, mainGlass, 28, 20, 42, 72.5f);
+        drawGlass(canvas, frontGlass, 28, 192.5f, 42, 42);
+        canvas.save();
+        canvas.scale(density, density);
+        shell(canvas, 28, 20, 42, 72.5f, candidate == CameraSelectGesture.BACK);
+        shell(canvas, 28, 192.5f, 42, 42, candidate == CameraSelectGesture.FRONT);
+        int ink = dark ? Color.WHITE : Color.BLACK;
+        icon(canvas, main, 38, 38.25f, 22, 16, ink);
+        icon(canvas, chevron, 40, 66.25f, 18, 8, ink);
+        icon(canvas, front, 39, 202.5f, 20, 22, ink);
+        canvas.restore();
+    }
+
+    private void drawGlass(Canvas canvas, Drawable glass, float x, float y, float w, float h) {
+        if (glass == null) return;
+        glass.setBounds(Math.round(x*density), Math.round(y*density), Math.round((x+w)*density), Math.round((y+h)*density));
+        glass.draw(canvas);
+    }
+
+    private void shell(Canvas canvas, float x, float y, float w, float h, boolean active) {
+        rect.set(x, y, x + w, y + h);
+        paint.setStyle(Paint.Style.FILL);
+        if (mainGlass == null) {
+            paint.setColor(dark ? 0xE5333C48 : 0xF2F3F5F7);
+            paint.setShadowLayer(12, 0, 4, 0x22000000);
+            canvas.drawRoundRect(rect, 21, 21, paint);
+            paint.clearShadowLayer();
+            paint.setShader(new LinearGradient(x, y, x+w, y+h, dark ? 0x558FA9C7 : 0xBFFFFFFF, dark ? 0x00333C48 : 0x22FFFFFF, Shader.TileMode.CLAMP));
+            canvas.drawRoundRect(rect, 21, 21, paint);
+            paint.setShader(null);
+        }
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setStrokeWidth(active ? 2f : .5f);
+        paint.setColor(active ? 0xFF008BFF : dark ? 0x55FFFFFF : 0xCCFFFFFF);
+        rect.inset(.5f, .5f);
+        canvas.drawRoundRect(rect, 21, 21, paint);
+        paint.setStyle(Paint.Style.FILL);
+    }
+
+    private void icon(Canvas canvas, Drawable icon, float x, float y, int w, int h, int color) {
+        canvas.save();
+        canvas.translate(x, y);
+        icon.setTintList(ColorStateList.valueOf(color));
+        icon.setBounds(0, 0, w, h);
+        icon.draw(canvas);
+        canvas.restore();
+    }
+}
