@@ -0,0 +1,61 @@
+package org.telegram.ui.Components.cameraselect;
+
+/** Event-driven camera selection. Coordinates are dp; recording starts only on release. */
+public final class CameraSelectGesture {
+    public static final int NONE = 0, FRONT = 1, BACK = 2;
+    public static final float FRONT_PULL = 24f, BACK_PULL = 206.625f, CANCEL_PULL = 72f;
+    private boolean active, recording, cancelled, dragged;
+    private int candidate;
+    private float backPull = BACK_PULL;
+    private float originX, originY, pull;
+
+    public void begin(float x, float y, long now) {
+        active = true;
+        recording = cancelled = dragged = false;
+        candidate = NONE;
+        originX = x;
+        originY = y;
+        pull = 0f;
+        backPull = BACK_PULL;
+    }
+
+    public void setBackPull(float distance) {
+        backPull = Math.max(FRONT_PULL + 16f, distance);
+    }
+
+    public void move(float x, float y, long now) {
+        if (!active || cancelled) return;
+        float dx = x - originX;
+        pull = Math.max(0f, originY - y);
+        dragged |= Math.abs(dx) > 8f || Math.abs(originY - y) > 8f;
+        if (dx <= -CANCEL_PULL) {
+            cancelled = true;
+            candidate = NONE;
+            return;
+        }
+        candidate = Math.abs(dx) > 64f ? NONE
+                : pull >= backPull ? BACK : pull >= FRONT_PULL ? FRONT : NONE;
+    }
+
+    public boolean isRailVisible() { return active && !cancelled && pull > 8f; }
+    public boolean isActive() { return active; }
+    public boolean isRecording() { return recording; }
+    public boolean isCancelled() { return cancelled; }
+    public boolean hasDragged() { return dragged; }
+    public float getPull() { return pull; }
+    public int getCandidate() { return candidate; }
+
+    /** Commit exactly once. Returning to the button before release cancels selection. */
+    public int finish() {
+        int result = active && !cancelled ? candidate : NONE;
+        active = false;
+        recording = result != NONE;
+        return result;
+    }
+
+    public void cancel() {
+        cancelled = true;
+        active = recording = false;
+        candidate = NONE;
+    }
+}
